{
  "schema_version": "1.0.0",
  "contract_id": "ia.visual-accessibility.screenreader",
  "status": "PARTIAL",
  "evidence_status": "NOT_VALIDATED",
  "mission": "Local-first, keyboard-first AI assistance for blind and low-vision users; core screen-reader functions must work without an AI model or network.",
  "principles": [
    "platform_accessibility_tree_is_primary",
    "ocr_and_vision_are_complementary_not_replacements",
    "no_invented_accessibility_properties",
    "keyboard_only_operation",
    "offline_core_without_api_keys",
    "privacy_by_default",
    "human_confirmation_for_destructive_actions",
    "separate_simulation_from_real_device_evidence"
  ],
  "common_element_fields": [
    "element_id",
    "parent_id",
    "accessible_name",
    "role",
    "description",
    "value",
    "states",
    "available_actions",
    "keyboard_shortcuts",
    "source_platform",
    "observed_at",
    "confidence"
  ],
  "recommended_states": [
    "focused",
    "focusable",
    "enabled",
    "selected",
    "checked",
    "expanded",
    "read_only",
    "required"
  ],
  "platform_adapters": [

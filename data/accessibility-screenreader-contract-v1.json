      "interface": "Microsoft UI Automation",
      "status": "NOT_VALIDATED",
      "official_docs": "https://learn.microsoft.com/en-us/windows/win32/winauto/uiauto-uiautomationoverview"
    },
    {
      "platform": "linux",
      "interface": "AT-SPI / ATK as supported by desktop and toolkit",
      "status": "NOT_VALIDATED",
      "official_docs": "https://gnome.pages.gitlab.gnome.org/at-spi2-core/devel-docs/index.html"
    },
    {
      "platform": "web",
      "interface": "HTML native semantics and WAI-ARIA where appropriate",
      "status": "NOT_VALIDATED",
      "official_docs": "https://www.w3.org/WAI/standards-guidelines/aria/"
    },
    {
      "platform": "android",
      "interface": "Native accessibility APIs",
      "status": "NOT_VALIDATED",
      "official_docs": "https://developer.android.com/guide/topics/ui/accessibility"
    },
    {
      "platform": "macos_ios",

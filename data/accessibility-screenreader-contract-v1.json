  "required_test_areas": [
    "accessible_name_role_state_and_value",
    "keyboard_navigation_and_focus_recovery",
    "dynamic_content_and_announcement_deduplication",
    "unicode_multilingual_and_code_pronunciation",
    "speech_interruptions_and_missing_audio_device",
    "braille_disconnect_and_unsupported_device",
    "offline_no_model_no_api_key",
    "malformed_or_hostile_platform_content",
    "real_screen_reader_interoperability",
    "real_hardware_validation_for_audio_braille_and_uefi"
  ],
  "evidence_rules": {
    "PASS": "Reproducible command, target OS and version, application, assistive technology and version, logs/results, and stated limits are recorded.",
    "PARTIAL": "Only a subset of required capabilities is implemented or tested.",
    "BLOCKED": "A concrete dependency, platform, device, or runtime blocker is documented.",
    "NOT_VALIDATED": "Code or specification exists but execution evidence is missing.",
    "simulation_is_not_physical_proof": true
  },
  "references": [
    "https://www.w3.org/WAI/standards-guidelines/aria/",

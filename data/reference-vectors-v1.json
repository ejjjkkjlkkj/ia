{
  "schema_version": 1,
  "contract": "ia-numeric-reference-v1",
  "numeric_type": "FP64 reference",
  "absolute_tolerance": 1e-12,
  "relative_tolerance": 1e-12,
  "claim_scope": "Reference vectors for implementation parity; not proof that every language port exists.",
  "vectors": [
    {
      "id": "matvec-2x2-v1",
      "operation": "matvec",
      "input": {"matrix": [[1, 2], [3, 4]], "vector": [5, 6]},
      "expected": [17.0, 39.0]
    },
    {
      "id": "matmul-2x3-by-3x2-v1",
      "operation": "matmul",
      "input": {"left": [[1, 2, 3], [4, 5, 6]], "right": [[7, 8], [9, 10], [11, 12]]},
      "expected": [[58.0, 64.0], [139.0, 154.0]]
    },
    {
      "id": "softmax-equal-logits-v1",
      "operation": "softmax",
      "input": {"logits": [0.0, 0.0]},
      "expected": [0.5, 0.5]
    },
    {
      "id": "cross-entropy-binary-v1",
      "operation": "cross_entropy",
      "input": {"logits": [0.0, 0.0], "target_index": 0},
      "expected": 0.6931471805599453
    },
    {
      "id": "causal-attention-equal-scores-v1",
      "operation": "causal_attention",
      "input": {"query": [[1.0], [1.0]], "key": [[1.0], [1.0]], "value": [[1.0], [2.0]]},
      "expected": [[1.0], [1.5]]
    }
  ]
}
